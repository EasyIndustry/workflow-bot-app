# Secretos y datos de una instalación de desarrollo (data/ al lado del código)
.env
data/
workspace/
plugins/
boot.env
# Wheels traídas a mano para instalar librerías de plugins sin internet (webapp/librerias.py)
wheels/

# Entorno
.venv/
__pycache__/
*.py[cod]

# Registro de la app corriendo desde el repo
webapp.log
webapp/logs/

# El tarball de un release del núcleo trae un VERSION que el repo del núcleo no
# tiene versionado y que nadie lee. Sin esto, cada actualización del núcleo lo
# deja suelto y el hook de pre-commit frena el commit de sincronización.
backend/VERSION

# Lo que deja aplicar una actualización sobre el repo (Config -> Actualizaciones
# contra este checkout): la carpeta anterior al lado, para poder revertir, y la
# marca de qué release se aplicó. La versión que vale la dice git; estas son
# locales de esta máquina.
*.anterior/
core-release.anterior.json
webapp-release.json

# Lo que construye installer/packaging/build_win.sh
installer/build/

# Editor
.vscode/
.idea/
